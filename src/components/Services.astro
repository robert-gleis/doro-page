---
// Services — two cards in Serene Practice style
---

<section id="leistungen" class="scroll-mt-24 mb-md">
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-md">
		<article class="bg-surface-container-low rounded-xl p-md">
			<div class="flex items-center gap-sm mb-md">
				<span
					class="material-symbols-outlined text-primary"
					aria-hidden="true">psychology</span
				>
				<h2 class="text-headline-md text-primary m-0">
					Verfahren
				</h2>
			</div>
			<ul class="space-y-sm text-body-md text-on-surface-variant">
				<li class="flex gap-sm items-start">
					<span
						class="material-symbols-outlined text-secondary text-[20px] mt-0.5 is-filled"
						aria-hidden="true">check_circle</span
					>
					<span>Psychoanalyse</span>
				</li>
				<li class="flex gap-sm items-start">
					<span
						class="material-symbols-outlined text-secondary text-[20px] mt-0.5 is-filled"
						aria-hidden="true">check_circle</span
					>
					<span>Tiefenpsychologie</span>
				</li>
				<li class="flex gap-sm items-start">
					<span
						class="material-symbols-outlined text-secondary text-[20px] mt-0.5 is-filled"
						aria-hidden="true">check_circle</span
					>
					<span>Säuglings-Kleinkind-Elternpsychotherapie (SKEPT)</span>
				</li>
				<li class="flex gap-sm items-start">
					<span
						class="material-symbols-outlined text-secondary text-[20px] mt-0.5 is-filled"
						aria-hidden="true">check_circle</span
					>
					<span>Fachpsychotherapeutin für Psychotraumatologie (präverbale und präsymbolische Traumatisierung)</span>
				</li>
			</ul>
		</article>

		<article class="bg-surface-container-low rounded-xl p-md">
			<div class="flex items-center gap-sm mb-md">
				<span
					class="material-symbols-outlined text-primary"
					aria-hidden="true">family_restroom</span
				>
				<h2 class="text-headline-md text-primary m-0">
					Weitere Angebote
				</h2>
			</div>
			<ul class="space-y-sm text-body-md text-on-surface-variant">
				<li class="flex gap-sm items-start">
					<span
						class="material-symbols-outlined text-secondary text-[20px] mt-0.5 is-filled"
						aria-hidden="true">check_circle</span
					>
					<span>Fallbesprechungen/Supervision für Jugendhilfe und andere Einrichtungen, die mit Kindern und Familien arbeiten</span>
				</li>
				<li class="flex gap-sm items-start">
					<span
						class="material-symbols-outlined text-secondary text-[20px] mt-0.5 is-filled"
						aria-hidden="true">check_circle</span
					>
					<span>Elternberatung</span>
				</li>
				<li class="flex gap-sm items-start">
					<span
						class="material-symbols-outlined text-secondary text-[20px] mt-0.5 is-filled"
						aria-hidden="true">check_circle</span
					>
					<span>
						Lehrpraxis für AusbildungskandidatInnen des
						Alfred-Adler-Instituts Aachen-Köln e.V.
					</span>
				</li>
			</ul>
		</article>
	</div>
</section>
