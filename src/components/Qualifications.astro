---
// Qualifications — grid of cards in Serene Practice style
---

<section id="qualifikationen" class="scroll-mt-24 mb-md">
	<div class="flex items-center gap-sm mb-md px-xs">
		<span
			class="material-symbols-outlined text-primary"
			aria-hidden="true">workspace_premium</span
		>
		<h2 class="text-headline-md text-primary m-0">Qualifikationen</h2>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-md">
		<article class="bg-surface-container-low rounded-xl p-md">
			<h3 class="text-body-lg font-semibold text-primary mb-sm m-0">
				Grundqualifikation
			</h3>
			<p class="text-body-md text-on-surface-variant">
				Tiefenpsychologisch fundierte und analytische Kinder- und
				Jugendpsychotherapeutin
			</p>
		</article>

		<article class="bg-surface-container-low rounded-xl p-md">
			<h3 class="text-body-lg font-semibold text-primary mb-sm m-0">
				SKEPT
			</h3>
			<p class="text-body-md text-on-surface-variant">
				Zusatzqualifikation in
				Säuglings-Kleinkind-Eltern-Psychotherapie
			</p>
		</article>

		<article class="bg-surface-container-low rounded-xl p-md">
			<h3 class="text-body-lg font-semibold text-primary mb-sm m-0">
				Psychotraumatologie
			</h3>
			<p class="text-body-md text-on-surface-variant">
				Weiterbildung zur Fachpsychotherapeutin für Psychotraumatologie
				(präverbale und präsymbolische Traumatisierung)
			</p>
		</article>
	</div>
</section>
