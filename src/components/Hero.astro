---
const imageSrc = `${import.meta.env.BASE_URL}image.jpeg`;
---

<div
	class="flex flex-col md:flex-col-reverse items-center pt-lg md:pt-md pb-xl gap-md md:gap-lg"
>
	<section class="flex flex-col items-center text-center">
		<p
			class="text-label-md text-secondary uppercase tracking-widest mb-sm max-w-[90%]"
		>
			Psychotherapeutische Praxis für Kinder, Jugendliche und junge
			Erwachsene (0–21 J.)
		</p>
		<h1
			class="text-headline-lg-mobile md:text-headline-lg text-primary mb-md"
		>
			Dorothea Preiß
		</h1>
		<p class="text-body-md md:text-body-lg text-on-surface-variant max-w-[80%]">
			Tiefenpsychologisch fundierte und analytische Kinder- und Jugendpsychotherapeutin Säuglings, Kleinkind-Elternpsychotherapeutin (SKEPT) Fachpsychotherapeutin für Psychotraumatologie.
		</p>
	</section>

	<div class="w-full flex justify-center">
		<div
			class="relative w-full aspect-[0.69] max-w-[320px] md:max-w-[420px] rounded-xl overflow-hidden shadow-[0_20px_40px_-15px_rgba(83,88,69,0.18)]"
		>
			<img
				alt="Aquarell-Illustration: Therapeutische Begegnung in zwei Sesseln"
				class="w-full h-full object-cover"
				src={imageSrc}
				loading="eager"
				decoding="async"
			/>
		</div>
	</div>
</div>
