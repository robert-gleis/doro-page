---
import Head from './Head.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
const homeUrl = import.meta.env.BASE_URL;
---

<html lang="de">
	<head>
		<Head
			title={title}
			description={description}
			canonicalPath={canonicalPath}
			includeJsonLd={false}
		/>
	</head>
	<body
		class="bg-surface-bright text-on-surface antialiased min-h-screen flex flex-col"
	>
		<a href="#main-content" class="skip-link">Zum Hauptinhalt springen</a>

		<main
			id="main-content"
			class="flex-1 w-full max-w-[1120px] mx-auto px-margin-mobile py-lg pb-xl"
		>
			<nav class="mb-lg" aria-label="Zurück zur Startseite">
				<a
					href={homeUrl}
					class="inline-flex items-center gap-xs text-label-md text-on-surface-variant hover:text-primary transition-colors duration-200 no-underline"
				>
					<span
						class="material-symbols-outlined text-[20px]"
						aria-hidden="true">arrow_back</span
					>
					Zur Startseite
				</a>
			</nav>

			<article
				class="max-w-[720px] mx-auto bg-surface-container-low rounded-xl p-md md:p-lg legal-content"
			>
				<slot />
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.legal-content :global(h1) {
		font-size: var(--text-headline-md);
		line-height: 1.3;
		font-weight: 600;
		color: var(--color-primary);
		margin: 0 0 1.5rem;
	}

	.legal-content :global(h2) {
		font-size: var(--text-body-lg);
		line-height: 1.4;
		font-weight: 600;
		color: var(--color-primary);
		margin: 2rem 0 0.75rem;
	}

	.legal-content :global(h3) {
		font-size: var(--text-body-md);
		line-height: 1.4;
		font-weight: 600;
		color: var(--color-on-surface);
		margin: 1.25rem 0 0.5rem;
	}

	.legal-content :global(p),
	.legal-content :global(li) {
		font-size: var(--text-body-md);
		line-height: 1.6;
		color: var(--color-on-surface-variant);
	}

	.legal-content :global(p) {
		margin: 0 0 1rem;
	}

	.legal-content :global(ul) {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
	}

	.legal-content :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.legal-content :global(a:hover) {
		color: var(--color-secondary);
	}

	.legal-content :global(address) {
		font-style: normal;
	}
</style>
